# Copy the keys you need into .env (never commit .env).

# DeepSeek: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Brave Search API, used by the scouts: https://api-dashboard.search.brave.com
BRAVE_API_KEY=

# Optional: an openFDA key raises the page size (100 -> 1000) and rate limit for FDA downloads
OPENFDA_API_KEY=

# Optional: a CourtListener token raises the rate limit for lawsuit lookups
COURTLISTENER_TOKEN=

# Optional overrides
# DEEPSEEK_FAST_MODEL=deepseek-flash
# DEEPSEEK_SMART_MODEL=deepseek-v4-pro
# NEWSROOM_DB=data/newsroom.db
# NEWSROOM_TOP_N=20
# NEWSROOM_MIN_COMPLAINTS=10
# NEWSROOM_SCOUT_BUDGET=30
# NEWSROOM_REPORTERS=3
