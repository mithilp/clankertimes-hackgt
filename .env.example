# Copy to .env on the box. Never commit .env.
# Provider: anthropic (default), gemini or deepseek
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
BRAVE_API_KEY=

# Hard stop on model spend across all workers (USD).
SPEND_CAP_USD=150

# Tuning knobs (defaults in newsroom/config.py)
# PROMOTE_THRESHOLD=0.55
# MAX_ACTIVE_STORIES=6
# TIPSTER_INTERVAL_S=600

# MVP: one reviewer. Full panel: verifier,skeptic,fairness
REVIEWERS=verifier

# --- Cheap first-run profile (IMPLEMENTATION_PLAN step 3+). Remove for the real run. ---
# MODEL_REPORTER=claude-sonnet-5
# MODEL_VERIFIER=claude-sonnet-5
# MODEL_SKEPTIC=claude-sonnet-5
# MODEL_FAIRNESS=claude-haiku-4-5
# MODEL_TIPSTER=claude-haiku-4-5
# MODEL_SCOUT=claude-haiku-4-5
# MODEL_SCORER=claude-haiku-4-5
# MODEL_EDITOR=claude-haiku-4-5
# MODEL_MEMORY=claude-haiku-4-5
# BEATS_FILE=/app/config/beats.test.json
# REPORTER_CONCURRENCY=1
# MAX_ACTIVE_STORIES=1
# TIPSTER_MAX_CALLS=10
# SUB_CLAIM_CALLS=8
# SCOUT_CONCURRENCY=3
