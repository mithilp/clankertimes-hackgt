# Copy the keys you need into .env (never commit .env).

# DeepSeek: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Brave Search API, used by the scouts: https://api-dashboard.search.brave.com
BRAVE_API_KEY=

# Optional: an openFDA key raises the page size (100 -> 1000) and rate limit for FDA downloads
OPENFDA_API_KEY=

# Optional: a CourtListener token raises the rate limit for lawsuit lookups
COURTLISTENER_TOKEN=

# Optional overrides
# DEEPSEEK_FAST_MODEL=deepseek-flash
# DEEPSEEK_SMART_MODEL=deepseek-v4-pro
# NEWSROOM_DB=data/newsroom.db
# NEWSROOM_TOP_N=20
# NEWSROOM_MIN_COMPLAINTS=10
# NEWSROOM_SCOUT_BUDGET=30
# NEWSROOM_REPORTERS=3

# --- Local run on a Claude plan instead of DeepSeek credits -----------------
# Needs the CLI: curl -fsSL https://claude.ai/install.sh | bash   then: claude  -> /login
# NEWSROOM_LLM_PROVIDER=claude_code
# CLAUDE_FAST_MODEL=claude-sonnet-5
# CLAUDE_SMART_MODEL=claude-opus-5
# NEWSROOM_CLAUDE_CONCURRENCY=2
# CLAUDE_BIN=claude

# --- Search with a local browser instead of the Brave API ------------------
# Needs: pip install playwright && playwright install chromium
# NEWSROOM_SEARCH_BACKEND=browser
# NEWSROOM_BROWSER_CHANNEL=chrome   # optional: drive installed Chrome instead of bundled Chromium

# --- Signals store: Astra DB (vector DB for Bossman -> McLovin) --------------
# See docs/prompts/astra-db.md. Set NEWSROOM_SIGNALS=memory to run offline.
# ASTRA_DB_API_ENDPOINT=
# ASTRA_DB_APPLICATION_TOKEN=
# ASTRA_DB_KEYSPACE=
# NEWSROOM_SIGNALS_COLLECTION=signals
# NEWSROOM_SIGNALS=astra
